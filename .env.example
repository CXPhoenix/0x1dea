# Public build-time visibility flag. VitePress envDir is repository root.
# Exact true enables; false, empty and all other supplied values disable.
# Remove this flag to use CF_PAGES_BRANCH=staging fallback.
# Edit the title/text props directly in blog/index.md.
# Restart dev or rebuild after environment changes; never put secrets here.
VITE_SITE_NOTICE_ENABLED=false
