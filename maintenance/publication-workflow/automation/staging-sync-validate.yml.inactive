# INACTIVE reference only: never receives PUBLICATION_WRITER_TOKEN.
name: Trusted staging synchronization validation
run-name: staging-sync:${{ inputs.operation }}:${{ inputs.head }}
on:
  workflow_dispatch:
    inputs:
      operation: {required: true, type: string}
      main: {required: true, type: string}
      staging: {required: true, type: string}
      head: {required: true, type: string}
      tree: {required: true, type: string}
      policy: {required: true, type: string}
permissions:
  contents: read
concurrency:
  group: publication-validation-${{ github.repository }}
  cancel-in-progress: false
jobs:
  validate:
    runs-on: macos-15
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0
          persist-credentials: false
          path: control
      - name: Prepare independent validator inputs without API credentials
        env:
          REPOSITORY: ${{ github.repository }}
          CONFIG: ${{ vars.PUBLICATION_CONFIG_DIR }}
          JOB_MANIFEST_SHA: ${{ vars.PUBLICATION_VALIDATOR_JOB_SHA256 }}
        shell: bash
        run: |
          set -euo pipefail
          test -n "$CONFIG"
          python3 control/scripts/publication-job.py prepare \
            --manifest "$CONFIG/validator-job.json" --manifest-sha256 "$JOB_MANIFEST_SHA" \
            --repository "$REPOSITORY" --role validator > "$RUNNER_TEMP/validator-job-receipt.json"
      - name: Validate exact inputs with trusted main code and isolated build
        env:
          INPUTS_JSON: ${{ toJSON(inputs) }}
          REPOSITORY: ${{ github.repository }}
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          import json, os, pathlib, subprocess, sys
          job = json.loads((pathlib.Path(os.environ['RUNNER_TEMP'])/'validator-job-receipt.json').read_bytes())
          inputs = pathlib.Path(job['snapshot_root'])
          subprocess.run([sys.executable,'control/scripts/staging-sync-remote.py','validate',
              '--dispatch-inputs-env','INPUTS_JSON','--repository',os.environ['REPOSITORY'],
              '--job-snapshot-root',str(inputs),'--job-binding-sha256',job['binding_sha256'],
              '--build-output',str(pathlib.Path(os.environ['RUNNER_TEMP'])/'sync-build')],check=True)
          PY
