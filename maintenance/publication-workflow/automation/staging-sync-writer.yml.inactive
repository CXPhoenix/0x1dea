# INACTIVE reference only: not under .github/workflows. P13 and activation review required.
name: Trusted staging synchronization writer
on:
  push:
    branches: [main]
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: publication-writers-${{ github.repository }}
  cancel-in-progress: false
jobs:
  writer:
    runs-on: macos-15
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          ref: main
          fetch-depth: 0
          persist-credentials: false
          path: control
      - name: Run trusted writer with separately provisioned external authority
        env:
          PUBLICATION_WRITER_TOKEN: ${{ secrets.PUBLICATION_WRITER_TOKEN }}
          REPOSITORY: ${{ github.repository }}
          CONFIG: ${{ vars.PUBLICATION_CONFIG_DIR }}
          REGISTRY_SHA: ${{ vars.PUBLICATION_REGISTRY_SHA256 }}
          ACTIVATION_SHA: ${{ vars.PUBLICATION_ACTIVATION_SHA256 }}
        shell: bash
        run: |
          set -euo pipefail
          test -n "$CONFIG"
          POLICY=$(python3 -c 'import hashlib,pathlib;print(hashlib.sha256(pathlib.Path("control/maintenance/publication-workflow/engineering-v1.json").read_bytes()).hexdigest())')
          python3 control/scripts/staging-sync-remote.py run \
            --repository "$REPOSITORY" --policy-sha256 "$POLICY" \
            --registry "$CONFIG/registry.json" --registry-sha256 "$REGISTRY_SHA" \
            --activation "$CONFIG/activation.json" --activation-sha256 "$ACTIVATION_SHA" \
            --state-dir "$RUNNER_TEMP/publication-writers" --allow-remote-write
