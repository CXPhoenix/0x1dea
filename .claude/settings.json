{
  "includeGitInstructions": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-staged-files.sh",
            "if": "Bash(git diff --cached*)",
            "timeout": 10,
            "statusMessage": "Scanning staged files for items that shouldn't be in version control..."
          }
        ]
      }
    ]
  }
}
